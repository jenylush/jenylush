# Copy to .env and adjust. Every value is optional for local development.

# Public address of the app (used in emails and links)
BASE_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
PLATFORM_NAME=Vowly
SUPPORT_EMAIL=hello@example.com

# Where the SQLite database and photos are stored. Back this folder up.
DATA_DIR=./data

# Serve wedding sites at <slug>.<SITE_BASE_DOMAIN> (needs wildcard DNS + TLS).
# Sites are always available at BASE_URL/w/<slug> as well.
SITE_BASE_DOMAIN=

# Secret used to sign site-unlock cookies. Generated and stored in the DB if empty.
APP_SECRET=

# Accounts with these emails become administrators when they sign up.
ADMIN_EMAILS=

# Email: resend | smtp | none. With "none" emails are recorded but never sent.
EMAIL_PROVIDER=none
EMAIL_FROM="Vowly <weddings@yourdomain.com>"
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
SMTP_URL=smtps://user:pass@smtp.example.com:465

# Freemium launch: keep payments off until a payment provider is connected.
PAYMENTS_ENABLED=false

# Background email worker
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MS=30000

# Behind a reverse proxy / load balancer that terminates HTTPS
TRUST_PROXY=false
COOKIE_SECURE=false
