# ─── Core ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, RDS or local Postgres all work)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/owambe
# Public base URL used in emails, WhatsApp messages and Paystack callbacks
APP_URL=http://localhost:3000
# Long random string. Used to sign session cookies' companion tokens. `openssl rand -hex 32`
SESSION_SECRET=change-me-to-a-long-random-string
# Protects /api/cron/* — Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me-too

# ─── Paystack (guest Aso Ebi payments) ───────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. Use sk_test_… while testing.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Leave blank in production. Only tests point this at a local mock server.
PAYSTACK_BASE_URL=

# ─── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. "Owambe Ledger <hello@yourdomain.ng>"
EMAIL_FROM=

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template names (Meta requires templates for business-initiated messages)
WHATSAPP_TEMPLATE_REMINDER=payment_reminder
WHATSAPP_TEMPLATE_CONFIRMATION=order_confirmation
# Webhook verification (any string you also enter in the Meta dashboard) and App Secret for signatures
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── File storage ────────────────────────────────────────────────────────
# "local" stores files in ./uploads (development). "supabase" uses Supabase Storage.
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=owambe-files
